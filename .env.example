# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (system of record — catalogue, enquiries, sell submissions,
# and artwork/movement image bytes — see the `images` table)
DATABASE_URL=

# Neon Auth (Managed Better Auth — /admin sign-in)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Email (added in build step 7 — enquiry / sell-submission notifications)
# RESEND_API_KEY=

# Payments (added in build step 7 — behind lib/payments.ts PaymentProvider seam)
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
